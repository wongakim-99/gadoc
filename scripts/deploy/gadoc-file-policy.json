{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": [
        "arn:aws:s3:::gadoc/gadoc/chat/*",
        "arn:aws:s3:::gadoc/gadoc/docs/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": [
        "arn:aws:s3:::gadoc/slacord/chat/*",
        "arn:aws:s3:::gadoc/slacord/docs/*"
      ]
    }
  ]
}
