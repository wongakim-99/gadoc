{
  "name": "@slacord/desktop",
  "version": "1.1.1",
  "description": "GaDoc 데스크톱 앱 (Electron + DMG)",
  "author": "kscold",
  "private": true,
  "license": "UNLICENSED",
  "main": "dist/main.js",
  "scripts": {
    "dev": "pnpm shell",
    "shell": "concurrently -k \"pnpm watch\" \"wait-on tcp:3002 file:dist/main.js && cross-env SLACORD_DESKTOP_START_URL=http://localhost:3002/auth/login electron .\"",
    "watch": "tsup --config tsup.config.ts --watch",
    "build": "tsup --config tsup.config.ts",
    "test": "node ../../scripts/prepare-electron.mjs && vitest run",
    "dist:dir": "pnpm build && electron-builder --dir --publish never",
    "dist:dmg": "pnpm build && electron-builder --mac dmg zip --publish never",
    "dist:win": "pnpm build && electron-builder --win nsis --publish never",
    "release:mac": "pnpm build && electron-builder --mac dmg zip --publish always",
    "release:win": "pnpm build && electron-builder --win nsis --publish always",
    "clean": "rm -rf dist release",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@slacord/contracts": "workspace:*",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "cross-env": "^10.1.0",
    "electron": "45.0.0",
    "electron-builder": "^26.0.12",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.kscold.slacord",
    "productName": "GaDoc",
    "copyright": "Copyright (c) 2026 kscold / Colding. All rights reserved.",
    "asar": true,
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "assets/icon.png"
      }
    ],
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "electronUpdaterCompatibility": ">=2.16",
    "publish": [
      {
        "provider": "github",
        "owner": "kscold",
        "repo": "gadoc"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "허들(음성 통화)을 위해 마이크 접근이 필요합니다.",
        "NSCameraUsageDescription": "영상 통화를 위해 카메라 접근이 필요합니다."
      }
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "icon": "build/icon.icns",
      "writeUpdateInfo": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always"
    }
  }
}
