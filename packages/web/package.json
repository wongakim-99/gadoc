{
  "name": "@slacord/web",
  "version": "1.1.2",
  "description": "GaDoc 웹 프론트엔드 (Next.js)",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "pnpm --filter @slacord/document-core build && next dev --port 3002",
    "build": "pnpm --filter @slacord/document-core build && next build",
    "start": "next start --port 3002",
    "test": "pnpm --filter @slacord/document-core build && vitest run",
    "lint": "next lint",
    "typecheck": "pnpm --filter @slacord/document-core build && tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\" --ignore-path .gitignore",
    "clean": "rm -rf .next node_modules"
  },
  "dependencies": {
    "@blocknote/core": "0.47.3",
    "@blocknote/mantine": "0.47.3",
    "@blocknote/react": "0.47.3",
    "@floating-ui/dom": "^1.7.4",
    "@hello-pangea/dnd": "^18.0.1",
    "@mantine/core": "8.3.11",
    "@mantine/hooks": "8.3.11",
    "@mantine/utils": "6.0.22",
    "@radix-ui/react-slot": "^1.2.4",
    "@slacord/contracts": "workspace:*",
    "@slacord/document-core": "workspace:*",
    "@tailwindcss/postcss": "^4.1.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.26",
    "lib0": "^0.2.119",
    "lucide-react": "^0.562.0",
    "next": "^16.4.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "sanitize-html": "^2.18.1",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.4.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.0",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.4.3",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
