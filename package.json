{
  "name": "slacord",
  "version": "1.1.1",
  "description": "가독 GaDoc - 문서, 대화, 할 일을 연결하는 Colding / kscold 협업 도구",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "brand:build": "node scripts/build-brand-assets.mjs",
    "dev:server": "pnpm --filter @slacord/server start:dev",
    "dev:web": "pnpm --filter @slacord/web dev",
    "dev:desktop": "concurrently -k \"pnpm --filter @slacord/web dev\" \"pnpm --filter @slacord/desktop dev\"",
    "profile:print": "node scripts/slacord-profile.mjs print",
    "dev:server:profile": "node scripts/slacord-profile.mjs run server:dev",
    "start:server:profile": "node scripts/slacord-profile.mjs run server:start",
    "dev:web:profile": "node scripts/slacord-profile.mjs run web:dev",
    "build:web:profile": "node scripts/slacord-profile.mjs run web:build",
    "start:web:profile": "node scripts/slacord-profile.mjs run web:start",
    "dev:stack:profile": "concurrently -k \"pnpm dev:server:profile\" \"pnpm dev:web:profile\"",
    "start:stack:profile": "concurrently -k \"pnpm start:server:profile\" \"pnpm start:web:profile\"",
    "version:all": "node scripts/set-monorepo-version.mjs",
    "release:desktop:preflight": "node scripts/check-desktop-release-secrets.mjs",
    "build:server": "pnpm --filter @slacord/server build",
    "build:web": "pnpm --filter @slacord/web build",
    "build:desktop": "pnpm --filter @slacord/desktop build",
    "test:server": "pnpm --filter @slacord/server test --runInBand",
    "test:document-core": "pnpm --filter @slacord/document-core test",
    "test:web": "pnpm --filter @slacord/web test",
    "test:desktop": "pnpm --filter @slacord/desktop test",
    "test:metadata": "node --test scripts/test/project-metadata.test.mjs",
    "test:e2e:web": "playwright test",
    "test:e2e:web:prepare": "playwright install chromium",
    "verify:web:mobile": "node scripts/verify-slacord-web-mobile.mjs",
    "verify:web:mobile:prepare": "playwright install webkit",
    "verify:live:profile": "node scripts/slacord-profile.mjs run verify:live",
    "verify:discord:mock:profile": "node scripts/slacord-profile.mjs run verify:discord-mock",
    "verify:full": "node scripts/verify-full.mjs",
    "dist:desktop": "pnpm --filter @slacord/desktop dist:dmg",
    "dist:desktop:win": "pnpm --filter @slacord/desktop dist:win",
    "release:desktop:mac": "pnpm --filter @slacord/desktop release:mac",
    "release:desktop:win": "pnpm --filter @slacord/desktop release:win",
    "start:server": "pnpm --filter @slacord/server start:prod",
    "start:web": "pnpm --filter @slacord/web start",
    "lint": "pnpm -r --if-present lint",
    "clean": "pnpm -r --if-present clean && rm -rf node_modules"
  },
  "devDependencies": {
    "sharp": "^0.35.5",
    "concurrently": "^9.2.1",
    "playwright": "^1.54.2",
    "prettier": "^3.4.2"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.34.9 <11"
  },
  "packageManager": "pnpm@10.34.9"
}
